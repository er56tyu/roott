# Telegram bot token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user ids allowed to use the bot, comma separated.
# Get yours from @userinfobot. Nobody else gets an answer.
TELEGRAM_ALLOWED_IDS=

# C2 base URL. Defaults to the lab deployment when unset.
VEXR_C2_URL=https://vexr-lab-c2-academic-production.up.railway.app

# Dashboard / operator API secret. If unset, the server generates one on first
# boot, stores it in the database and logs it once; the bot's /token command
# shows the same value. Set it here to choose your own.
VEXR_OPERATOR_TOKEN=

# Optional. Set only if api.telegram.org is not reachable directly.
# Examples: socks5://127.0.0.1:10808  or  http://127.0.0.1:8080
TELEGRAM_PROXY=
